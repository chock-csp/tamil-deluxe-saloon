# Database Connection (SQLite local or Vercel Postgres / Supabase)
DATABASE_URL="file:./dev.db"

# Admin Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"
ADMIN_INITIAL_PASSWORD="saloon123"

# Optional Manual Playlist Override for Vercel Serverless (No code changes / No GitHub commits needed)
# Un-comment one of the options below in Vercel Project Settings to manually override the active playlist:
# PLAYLIST_OVERRIDE_INDEX=0       # 0-based index: 0 = Row 1 (Ilayaraja), 1 = Row 2 (AR Rahman), etc.
# PLAYLIST_OVERRIDE_ID=row-2      # Row ID string: row-1, row-2, row-3, etc.

# Public site URL used for OAuth redirect URIs (Vercel URL is used automatically if unset)
# APP_URL="https://tamil-deluxe-saloon.vercel.app"

# YouTube Data API OAuth (clone playlists onto your channel)
# Create a Google Cloud OAuth client (Web application) and enable YouTube Data API v3.
# Redirect URI: https://YOUR-DOMAIN/api/oauth/youtube/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Spotify Web API OAuth (create a public playlist with matching tracks)
# Create a Spotify Developer app. Redirect URI: https://YOUR-DOMAIN/api/oauth/spotify/callback
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""


