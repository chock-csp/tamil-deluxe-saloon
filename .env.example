# Copy this file to `.env.local` and fill in your own values.
# Never commit real secrets. On Vercel, set these under
# Project Settings → Environment Variables (or Vercel Secrets).

# Required: random signing key for admin session cookies.
# Generate one with: openssl rand -base64 32
JWT_SECRET=""

# Required: admin login username (defaults to "admin" if unset)
ADMIN_USERNAME="admin"

# Required: admin login password. Set this in Vercel — do not commit it.
# Legacy alias: ADMIN_INITIAL_PASSWORD is still read if ADMIN_PASSWORD is empty.
ADMIN_PASSWORD=""

# Optional: bcrypt hash instead of a plaintext ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=""

# Optional Manual Playlist Override for Vercel Serverless (No code changes / No GitHub commits needed)
# Un-comment one of the options below in Vercel Project Settings to manually override the active playlist:
# PLAYLIST_OVERRIDE_INDEX=0       # 0-based index: 0 = Row 1 (Ilayaraja), 1 = Row 2 (AR Rahman), etc.
# PLAYLIST_OVERRIDE_ID=row-2      # Row ID string: row-1, row-2, row-3, etc.
